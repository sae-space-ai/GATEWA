# ============================================================
# LOCAL GATEWAY - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Port for the local gateway (default: 3456)
GATEWAY_PORT=3456

# Ollama configuration - ONLY change if Ollama runs on non-default settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Gateway authentication secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# THIS MUST MATCH THE GATEWAY_SECRET IN YOUR CLOUD BACKEND
GATEWAY_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# Request limits
MAX_PROMPT_SIZE=50000
REQUEST_TIMEOUT=120000
MAX_CONCURRENT_REQUESTS=3
