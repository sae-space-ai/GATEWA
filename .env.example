# ============================================================
# GATEWA CLOUD - Environment Configuration
# ============================================================
# Set these in Vercel Dashboard > Settings > Environment Variables
# NEVER commit actual secrets to version control!

# GATEWA Local Bridge URL (HTTPS tunnel provided by Cloudflare Tunnel or similar)
# This is the PUBLIC URL of your local bridge, NOT localhost
# Example: https://your-tunnel.trycloudflare.com
GATEWA_BRIDGE_URL=https://your-bridge-tunnel.example.com

# Bridge authentication secret (MUST match GATEWA_BRIDGE_SECRET in local bridge)
GATEWA_BRIDGE_SECRET=your-secret-here
