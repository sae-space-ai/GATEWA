# ============================================================
# CLOUD APPLICATION - Environment Configuration
# ============================================================
# Set these in Vercel Dashboard > Settings > Environment Variables
# NEVER commit actual secrets to version control!

# Local Gateway URL (HTTPS tunnel provided by Cloudflare Tunnel or similar)
# This is the PUBLIC URL of your local gateway, NOT localhost
# Example: https://your-tunnel.trycloudflare.com
GATEWAY_PUBLIC_URL=https://your-gateway-tunnel.example.com

# Gateway authentication secret (MUST match GATEWAY_SECRET in local gateway)
GATEWAY_SECRET=your-secret-here
